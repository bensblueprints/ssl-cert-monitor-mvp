# Certwatch configuration — copy to .env and edit

# Port the web app listens on
PORT=5346

# Admin password for the dashboard (change this!)
ADMIN_PASSWORD=change-me

# SQLite database location
DB_PATH=./data/certwatch.db

# How often each domain's certificate is re-checked (ms). Default 6 hours.
CHECK_INTERVAL_MS=21600000

# SMTP for email alerts (optional — webhook alerts work without SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
